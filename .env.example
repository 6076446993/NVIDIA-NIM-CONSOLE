# Preferred Nexus route: AI Collaboration provider-neutral gateway
AI_COLLABORATION_BASE_URL=https://ai-collaboration-bwkm.onrender.com
AI_COLLABORATION_BEARER_TOKEN=replace-with-runtime-secret
AI_COLLABORATION_MODEL=nexus-coding

# Explicit direct-NIM fallback. Leave false to require AI Collaboration.
NIM_DIRECT_MODE=false
NIM_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Cross-repository CI token used only by GitHub Actions to read private sibling repos.
# Store the real value as the NEXUS_CROSS_REPO_READ_TOKEN repository secret.
NEXUS_CROSS_REPO_READ_TOKEN=
