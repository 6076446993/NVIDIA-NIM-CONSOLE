#!/usr/bin/env bash
set -euo pipefail

echo "=================================================="
echo "    NVIDIA NIM CONSOLE: PRE-PUSH SAFETY CHECK     "
echo "=================================================="

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -Command "\$errors=\$null; [System.Management.Automation.Language.Parser]::ParseFile('NimConsole.ps1',[ref]\$null,[ref]\$errors) | Out-Null; if(\$errors.Count){\$errors | ForEach-Object { Write-Error \$_.Message }; exit 1}"
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -Command "\$errors=\$null; [System.Management.Automation.Language.Parser]::ParseFile('NimConsole.ps1',[ref]\$null,[ref]\$errors) | Out-Null; if(\$errors.Count){\$errors | ForEach-Object { Write-Error \$_.Message }; exit 1}"
else
  echo "[BLOCKED] PowerShell is required to parse NimConsole.ps1 before push." >&2
  exit 1
fi

python -m py_compile AIcollaborationcouncilgate.py

echo "Local syntax checks passed."
echo "Push is still UNVERIFIED until GitHub's Crucible & AI Council Gate succeeds."
